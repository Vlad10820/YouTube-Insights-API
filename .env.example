# Copy this file to .env and fill in real values. Never commit .env.

# Key that clients send in the X-API-Key header
API_KEY=change-me
REQUIRE_API_KEY=true

# Google YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

RATE_LIMIT_DEFAULT=60/minute
ENABLE_METRICS=true
CORS_ALLOW_ORIGINS=*

# Only needed when selling the API through RapidAPI
REQUIRE_RAPIDAPI_PROXY_SECRET=false
RAPIDAPI_PROXY_SECRET=
